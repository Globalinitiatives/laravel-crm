# -*- coding: utf-8 -*-
# Pristine upstream Krayin CRM (no customizations yet) - Dockerfile
FROM php:8.3-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git zlib1g-dev libfreetype6-dev libjpeg-dev libwebp-dev libonig-dev libzip-dev
RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp
RUN docker-php-ext-install -j$(nproc) calendar pdo_mysql mbstring zip gd
COPY --from=composer:2.8 /usr/bin/composer /usr/bin/composer
# Copy the node image's /usr/local/bin directory so all symlinks are preserved
# (npm -> ../lib/node_modules/npm/bin/npm-cli.js, etc.). Copying individual files
# dereferences these symlinks and breaks them, causing Cannot find module ../lib/cli.js.
COPY --from=node:20-bookworm /usr/local/ /usr/local/  # preserve npm/npx/yarn symlinks (single-file COPY dereferences them)
COPY --from=node:20-bookworm /usr/local/include/node /usr/local/include/node
ENV PATH=/usr/local/bin:$PATH
ENV NODE_ENV=production
WORKDIR /var/www/html
COPY composer.json composer.lock ./
COPY artisan ./
COPY bootstrap/ ./bootstrap/
COPY config/ ./config/
COPY database/ ./database/
COPY lang/ ./lang/
COPY packages/ ./packages/
COPY resources/ ./resources/
COPY routes/ ./routes/
COPY storage/ ./storage/
COPY tests/ ./tests/
COPY app/ ./app/
RUN composer install --no-interaction --no-dev --optimize-autoloader
RUN php artisan package:discover --ansi
RUN rm -rf node_modules
RUN npm install --no-audit --loglevel=error
RUN npm run build --no-audit --loglevel=error
COPY nginx.conf /etc/nginx/nginx.conf
EXPOSE 80
CMD ["sh", "-c", "php-fpm -D && nginx -g 'daemon off;'"]
